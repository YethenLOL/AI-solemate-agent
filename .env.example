# ======== 模型（默认 DeepSeek，任何 OpenAI 兼容接口都行）========
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=800

# ======== QQ（NapCat / OneBot v11）========
# 你自己的 QQ 号（必填）——不是机器人登录的那个号，是你平时用来聊天的号
OWNER_QQ=
# NapCat 里新建 WebSocket 服务器，默认端口 3001
ONEBOT_WS_URL=ws://127.0.0.1:3001
# 和 NapCat 里设置的 token 保持一致；没设就留空
ONEBOT_ACCESS_TOKEN=

# 私聊白名单（逗号分隔，可留空）。留空时只有 OWNER_QQ 能私聊
ALLOWED_USERS=
# 允许拉进来的群（逗号分隔）。留空 = 不在任何群说话
ALLOWED_GROUPS=
# 群里必须 @ 她或者带唤醒词才回复
GROUP_AT_REQUIRED=true
# 群回复时带不带 @
GROUP_REPLY_AT=true
# 自动通过主人/白名单号发来的好友请求
AUTO_ACCEPT_FRIENDS=true
WAKE_WORDS=大肥鱼,小鱼,肥鱼

# ======== B 站 ========
# 从浏览器复制登录后的 Cookie（至少含 SESSDATA）：
# 既能看字幕、减少风控，也是读取「主人观看历史」做技能学习的必要条件
BILI_COOKIE=
BILI_MIN_INTERVAL=0.6

# ======== 电脑感知与安全操作（macOS）========
# 是否允许主人私聊让奥米操作电脑（打开 App/网页、音量、通知、锁屏等）
COMPUTER_ENABLED=true
# 只允许打开这些 App（逗号分隔）；留空 = 允许任意已安装 App
COMPUTER_ALLOWED_APPS=
# 是否定时记录当前前台 App / 窗口标题
ACTIVITY_ENABLED=true
ACTIVITY_INTERVAL_SECONDS=45
# 空闲超过多少秒不记录
ACTIVITY_IDLE_SKIP_SECONDS=900
# 活动记录保留天数
ACTIVITY_RETENTION_DAYS=7
# 不记录的 App（1Password/密码类默认排除）
ACTIVITY_BLOCKLIST=1Password,Keychain Access,Bitwarden,Passwords,loginwindow,ScreenSaver

# ======== B 站学习 / 技能库 ========
# 是否从主人的 B 站观看历史里学习，并生成 Markdown 技能卡
LEARNING_ENABLED=true
# 每隔多少分钟看一次观看历史（30~1440）
LEARNING_INTERVAL_MINUTES=180
# 每次读取多少条历史（5~50）
LEARNING_HISTORY_LIMIT=30
# 每轮最多生成几个技能（1~5）
LEARNING_ITEMS_PER_RUN=2
# 至少看了多少秒才算「在学」，避免把点开就关掉的视频也拿去学
LEARNING_MIN_WATCH_SECONDS=120
# 没有 Cookie 时可用的自动搜索关键词；填了后「立即学习」会按关键词搜 B 站
LEARNING_KEYWORDS=雅思,Python
# 技能卡保存目录；留空 = 应用数据目录下 skills/
# SKILLS_DIR=
# 单张技能卡最多多少字
SKILL_MAX_CHARS=5000
# 私聊时按主人这句话最多注入几张相关技能
SKILL_INJECT_LIMIT=3

# ======== 屏幕文字识别（可选）========
# 主人私聊明确让你「看屏幕」时，才截图并用本机 Vision OCR；不保存截图
# 需要给大肥鱼 App/终端开启「系统设置 → 隐私与安全性 → 屏幕录制」
SCREEN_READ_ENABLED=false
SCREEN_READ_MAX_CHARS=4000
SCREEN_READ_TIMEOUT=45

# ======== DeepSeek Harness（可选，本地学习运行时）========
# true = 用本机 DSH headless 整理学习笔记（需要 Node >=22.19 + DSH）
# QQ 对话里的工具调用仍走上面的 OpenAI 兼容接口
DSH_ENABLED=false
# true = QQ 聊天也走 DSH；DSH 自带文件/终端工具会被禁用，改用本地安全工具协议
DSH_CHAT=false
# 可留空自动找；也可显式指定
DSH_NODE=
DSH_ENTRY=
DSH_PROFILE=headless
DSH_TIMEOUT=240

# ======== 人格与记忆 ========
PERSONA_NAME=大肥鱼
# 人格卡文件：只写「你是谁 / 怎么说话」，改完下一条消息自动生效
PERSONA_FILE=personas/dafeiyu.md
# 人格卡最多注入多少字符（1000~20000，建议 3000~5000）
PERSONA_MAX_CHARS=6000
# 追加的额外设定，比如：说话更黏人一点
PERSONA_EXTRA=
TIMEZONE=Asia/Shanghai
# 每次带多少轮聊天记录给模型
HISTORY_TURNS=16
# 单条回复最长多少字（超了会分条发）
MAX_REPLY_CHARS=1200
# 数据库位置，默认 data/dafeiyu.db
# DATABASE_PATH=./data/dafeiyu.db

# ======== 主动行为 ========
# 会不会自己找你聊天
PROACTIVE_ENABLED=true
# 主动间隔（分钟，随机取区间）
PROACTIVE_MIN_MINUTES=50
PROACTIVE_MAX_MINUTES=140
# 每天最多主动发几条
PROACTIVE_DAILY_LIMIT=12
# 安静时段，这个区间内不主动发消息；填 off 关闭
QUIET_HOURS=1-8

# ======== 夜间自主（复刻 dsh-bili-whale）========
# 是否启用「生物钟」：窗口内随机醒来、看视频、写两本日记、偶尔分享
NIGHT_ENABLED=true
# 作息窗口，可写多个，用逗号分隔；xN 表示这个窗口醒几次
# 例：20:00-24:00x2,12:30-13:00
NIGHT_WINDOWS=20:00-24:00
# 每个窗口默认醒几次（窗口里写了 xN 时以 xN 为准）
NIGHT_WAKES=1
# 今天「不想看」的概率（0~1），跳过也会写日记
NIGHT_SKIP_CHANCE=0.3
# 相邻两次醒来至少间隔多少分钟
NIGHT_MIN_GAP_MINUTES=10
# 每次醒来先轻读几条候选
NIGHT_MAX_VIDEOS=5
# 其中深读几条（含字幕/热评/弹幕热点）
NIGHT_DEEP_READ=2
# 启动后多久开始检查生物钟（秒）
NIGHT_INITIAL_DELAY=45

# 是否允许把深读后排名第一的视频分享到主人 QQ
SHARE_ENABLED=true
# 分享最低分（0~20），低于这个分不打扰主人
SHARE_MIN_SCORE=13
# 每天最多分享几条
SHARE_DAILY_LIMIT=3
# 主人连续多少天没回应后，每天最多只分享 1 条
SILENT_AFTER_DAYS=3
# 连续多少天没回应后完全停止分享（日记照写）
SILENT_STOP_DAYS=7
# 写完日记是否把「给主人的信」摘要发到 QQ
DIARY_PUSH=true
# 日记目录；留空 = 应用数据目录下 diary/
# DIARY_DIR=

# ======== 抽帧看画面（需要 ffmpeg：brew install ffmpeg）========
# 深读时在弹幕热点处截 1~6 张图，用本机 macOS Vision OCR 读画面文字
FRAMES_ENABLED=true
# 每次深读抽几张
FRAMES_COUNT=3
# 帧的最大宽度（默认 720；太小会看不清界面文字）
FRAMES_MAX_WIDTH=720
# 单帧超时（秒）
FRAMES_TIMEOUT=60
# OCR 文字上限
FRAMES_OCR_MAX_CHARS=2000
# 自定义 ffmpeg 路径；留空自动找 PATH / Homebrew / /usr/local/bin
# FFMPEG_PATH=

# 请求保护：读/写预算 + 412 递增暂停（状态在 data/traffic.json）
TRAFFIC_GUARD_ENABLED=true
BILI_READ_HOURLY=600
BILI_READ_DAILY=3000
BILI_WRITE_HOURLY=12
BILI_WRITE_DAILY=30
BILI_WRITE_GAP_SECONDS=120

# 自己刷 B 站
BROWSE_ENABLED=true
BROWSE_INTERVAL_MINUTES=40
BROWSE_LIMIT=20
# 主动分享视频时先发封面图（NapCat 拉不到外链图时关掉）
SHARE_COVER=false

LOG_LEVEL=INFO
